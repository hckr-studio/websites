{% extends "layouts/website.njk" %}

{% block head %}
  <link rel="canonical" href="https://hckr.studio/">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:domain" content="hckr.studio">
  <meta name="twitter:site" content="@hckr_studio">
  <meta name="twitter:image" property="og:image" content="{{ "og-image.png" | assetUrl("images") }}">
  <link rel="me" href="https://bsky.app/profile/hckr.studio">
{% endblock %}

