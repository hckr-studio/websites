{%- from 'macros/helpers.njk' import sprite, spriteTarget, importmapTarget -%}
<!doctype html>
<html lang="{{ meta.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,viewport-fit=cover">
  <meta name="text-scale" content="scale">
  {% if collections.images %}
    <meta http-equiv="delegate-ch"
          content="sec-ch-width https://res.cloudinary.com; sec-ch-dpr https://res.cloudinary.com; sec-ch-viewport-width https://res.cloudinary.com;">
  {% endif %}
  {% block head_pragma %}{% endblock %}
  <title>{% block title %}{{ meta.title }} {{ title }}{% endblock %}</title>
  {% if collections.images %}
    <link rel="preconnect" href="https://res.cloudinary.com">
  {% endif %}
  {% block head_preconnect %}{% endblock %}
  <style>
    @font-face {
      font-family: "Right Grotesk";
      font-display: swap;
      src: url("{{ "pp-right-grotesk-variable.latin.woff2" | assetUrl("fonts") }}") format("woff2");
      unicode-range: U+0-FF, U+131, U+152, U+153, U+2BB, U+2BC, U+2C6, U+2DA, U+2DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    @font-face {
      font-family: "Right Grotesk";
      font-display: swap;
      src: url("{{ "pp-right-grotesk-variable.latin-ext.woff2" | assetUrl("fonts") }}") format("woff2");
      unicode-range: U+0100-0101, U+0104-0130, U+0132-0151, U+0154-017F, U+018F, U+0192, U+01A0-01A1, U+01AF-01B0, U+01FA-01FF, U+0218-021B, U+0237, U+0259, U+1E80-1E85, U+1E9E, U+20A1, U+20A4, U+20A6, U+20A8-20AA, U+20AD-20AE, U+20B1-20B2, U+20B4-20B5, U+20B8-20BA, U+20BD, U+20BF;
    }
    @font-face {
      font-family: "Right Grotesk Mono";
      font-display: swap;
      src: url("{{ "pp-right-grotesk-mono-variable.latin.woff2" | assetUrl("fonts") }}") format("woff2");
      unicode-range: U+0-FF, U+131, U+152, U+153, U+2BB, U+2BC, U+2C6, U+2DA, U+2DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    @font-face {
      font-family: "Right Grotesk Mono";
      font-display: swap;
      src: url("{{ "pp-right-grotesk-mono-variable.latin-ext.woff2" | assetUrl("fonts") }}") format("woff2");
      unicode-range: U+0100-0101, U+0104-0130, U+0132-0151, U+0154-017F, U+018F, U+0192, U+01A0-01A1, U+01AF-01B0, U+01FA-01FF, U+0218-021B, U+0237, U+0259, U+1E80-1E85, U+1E9E, U+20A1, U+20A4, U+20A6, U+20A8-20AA, U+20AD-20AE, U+20B1-20B2, U+20B4-20B5, U+20B8-20BA, U+20BD, U+20BF;
    }
  </style>
  <link rel="stylesheet" href="{{ 'index.css' | assetUrl('stylesheets') }}">
  {% block head_stylesheets %}{% endblock %}
  {% block head_preload %}{% endblock %}
  {% block head_async_scripts %}{% endblock %}
  <meta name="description" content="{{ description or meta.description }}">
  <meta name="generator" content="{{ generator or '@hckr_/blendid - static site generator and assets pipeline' }}">
  <meta name="author" content="https://hckr.studio">
  <meta name="color-scheme" content="light dark">
  <link rel="manifest" href="{{ 'manifest.json' | assetUrl('static') }}">
  <link rel="canonical" href="{{ canonicalUrl or meta.url }}">
  {% include "shared/app-icons.html" %}
  {% block head %}{% endblock %}
</head>
<body id="{{ bodyId }}" vocab="https://schema.org/" type="{{ bodySchema }}">
<header>
  <hgroup>
    <h1 property="name">HCKR<em>.studio</em></h1>
  </hgroup>

  <blockquote>
    <dl>
      <dt><code>/ˈhækə(r)/</code></dt>
      <dd>a person who uses or writes computer programs with enthusiasm and skill</dd>
      <dt><code>/ˈstjuːdiəʊ/</code></dt>
      <dd>a room where an artist works</dd>
    </dl>
  </blockquote>
</header>
{% block content %}{% endblock %}
<footer>
  <p>Follow us on:
    <a href="https://www.youtube.com/@hckr_tv">YouTube</a>,
    <a href="https://github.com/hckr-studio">GitHub</a>,
    <a href="https://www.linkedin.com/company/hckr-studio/">LinkedIn</a>,
    <a href="https://bsky.app/profile/hckr.studio">Bluesky</a>,
    <a href="https://indieweb.social/@hckr.studio@bsky.brid.gy">Mastodon</a>.
  </p>
  <p>©️ 2024 - {{ currentYear }} hckr.studio, s.r.o. </p>
  <p>
    <a href="https://hckr.space/">hckr.space</a>
    _
    <a href="https://hckr.tv/">hckr.tv</a>
    _
    <a href="https://hckr.party/">hckr.party</a>
  </p>
</footer>
{% block scripts %}{% endblock %}
{{ spriteTarget() }}
</body>
</html>
